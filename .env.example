NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/db_gcims_test
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=15m
GCIMS_DEFAULT_COMPANY_CODE=GOURMET-COFFEE
GCIMS_DEFAULT_OUTLET_CODE=MAIN
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# QRIS provider is intentionally not enabled until a provider is selected and integrated.

# Test-only cash confirmation; only works on db_gcims_test and never in production.
GCIMS_ALLOW_TEST_ONLY_PAYMENT=false

# Reservation expires after this many minutes (1–120; default 15).
GCIMS_STOCK_RESERVATION_TTL_MINUTES=15
